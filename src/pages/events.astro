---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import PricingCard from '../components/pricing/PricingCard.astro';
import Button from '../components/common/Button.astro';
import { getCollection } from 'astro:content';
import { translations } from '../i18n/translations';

const t = translations.ceremonies;
const common = translations.common;

// Get ceremony packages from content collection
const ceremonyPackages = await getCollection('ceremonies');
const sortedPackages = ceremonyPackages.sort((a, b) => a.data.order - b.data.order);

// Symbolic rituals data
const rituals = [
  {
    name: t.enamorarte,
    color: 'sage',
    description: {
      en: 'A unique engagement ceremony where the couple paints a shared canvas together, guided by an officiant. This intimate moment symbolizes unity, creativity, and the beginning of their journey, expressing their love through art instead of words.',
      es: 'Una ceremonia de compromiso única donde la pareja pinta un lienzo compartido, guiados por una oficiante. Este momento íntimo simboliza la unión, la creatividad y el comienzo de su camino, expresando su amor a través del arte en lugar de palabras.'
    }
  },
  {
    name: t.sandCeremony,
    color: 'terracotta',
    description: {
      en: 'It is a symbolic ritual in which the couple pours different colored sands together, representing the joining of their lives, love, and families into a unified whole.',
      es: 'Es un ritual simbólico en el que la pareja vierte arenas de distintos colores, representando la unión de sus vidas, su amor y sus familias en un todo compartido.'
    }
  },
  {
    name: t.handfasting,
    color: 'gold',
    description: {
      en: 'The word derives from the Old Norse term “handfesta,” where you promise to love each other today, tomorrow, and forever.',
      es: 'La palabra proviene del termino nórdico antiguo "handfesta", donde prometen amarse hoy, mañana y para siempre.'
    }
  },
  {
    name: t.treePlanting,
    color: 'sage',
    description: {
      en: 'It is a symbolic ritual where the couple plants a tree or plant to represent the growth, strength, and care of their relationship.',
      es: 'Es un ritual simbólico en el que la pareja planta un árbol o una planta para representar el crecimiento, la fortaleza y el cuidado de su relación.'
    }
  },
  {
    name: t.timeCapsule,
    color: 'terracotta',
    description: {
      en: 'It is a symbolic ritual in which the couple places letters, notes, or meaningful objects into a capsule to be opened in the future. It represents their commitment, memories, and hopes for a shared life, creating a lasting treasure to revisit and celebrate their love over time.',
      es: 'Es un ritual simbólico en el que la pareja guarda cartas, notas u objetos personales en una cápsula para abrirla en el futuro. Representa su compromiso, sus recuerdos y sus esperanzas de una vida compartida, creando un tesoro duradero para revisitar y celebrar su amor con el paso del tiempo.'
    }
  },
  {
    name: t.redThread,
    color: 'gold',
    description: {
      en: 'It is a symbolic ritual rooted in East Asian folklore, particularly Chinese and Japanese traditions. During the ceremony, the couple ties a red string around their pinky fingers, symbolizing their unbreakable bond and the belief that fate has brought them together.',
      es: 'Es un ritual simbólico con origen en el folclore de Asia oriental, especialmente en las tradiciones china y japonesa. Durante la ceremonia, la pareja ata un hilo rojo alrededor de sus dedos meñiques, simbolizando su vínculo irrompible y la creencia de que el destino los ha unido.'
    }
  },
];
---

<Layout
  title="Wedding Ceremonies | Laura Vicente - EnamorARTE"
  description="Personalized bilingual wedding ceremonies in English and Spanish. Create a meaningful ceremony that celebrates your unique love story."
>
  <Header lang="en" />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative py-20 md:py-32 watercolor-bg overflow-hidden">
      <div class="absolute inset-0">
        <div class="absolute top-10 -right-20 w-64 h-64 bg-gold-200/40 rounded-full blur-3xl"></div>
        <div class="absolute bottom-10 -left-20 w-80 h-80 bg-terracotta-200/30 rounded-full blur-3xl"></div>
      </div>

      <div class="container-narrow mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <span class="font-script text-2xl md:text-3xl text-gold-600">EnamorARTE</span>
        <h1 class="mt-4 text-warm-900">
          <span data-lang="en">{t.pageTitle.en}</span>
          <span data-lang="es" class="hidden">{t.pageTitle.es}</span>
        </h1>
        <p class="mt-6 text-xl text-warm-600 max-w-2xl mx-auto">
          <span data-lang="en">{t.intro.en}</span>
          <span data-lang="es" class="hidden">{t.intro.es}</span>
        </p>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="section-padding bg-white">
      <div class="container-wide mx-auto">
        <div class="text-center mb-16">
          <h2>
            <span data-lang="en">{t.pricingTitle.en}</span>
            <span data-lang="es" class="hidden">{t.pricingTitle.es}</span>
          </h2>
          <div class="mt-4 w-24 h-1 bg-gradient-to-r from-terracotta-400 via-gold-400 to-sage-400 mx-auto rounded-full"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto items-start">
          {sortedPackages.map((pkg) => (
            <div>
              <div data-lang="en">
                <PricingCard
                  title={pkg.data.title}
                  price={pkg.data.price}
                  features={pkg.data.features}
                  featured={pkg.data.featured}
                  lang="en"
                />
              </div>
              <div data-lang="es" class="hidden">
                <PricingCard
                  title={pkg.data.titleEs}
                  price={pkg.data.price}
                  features={pkg.data.featuresEs}
                  featured={pkg.data.featured}
                  lang="es"
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Symbolic Rituals Section -->
    <section class="section-padding bg-warm-50">
      <div class="container-wide mx-auto">
        <div class="text-center mb-12">
          <h2>
            <span data-lang="en">{t.ritualsTitle.en}</span>
            <span data-lang="es" class="hidden">{t.ritualsTitle.es}</span>
          </h2>
          <p class="mt-4 text-warm-600 max-w-2xl mx-auto">
            <span data-lang="en">{t.ritualsDesc.en}</span>
            <span data-lang="es" class="hidden">{t.ritualsDesc.es}</span>
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {rituals.map((ritual) => (
            <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class={`w-12 h-12 mx-auto mb-4 rounded-full flex items-center justify-center ${
                ritual.color === 'terracotta' ? 'bg-terracotta-100' :
                ritual.color === 'gold' ? 'bg-gold-100' : 'bg-sage-100'
              }`}>
                <svg
                  class={`w-6 h-6 ${
                    ritual.color === 'terracotta' ? 'text-terracotta-500' :
                    ritual.color === 'gold' ? 'text-gold-500' : 'text-sage-500'
                  }`}
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
              <h3 class="text-lg font-medium text-warm-800 text-center">
                <span data-lang="en">{ritual.name.en}</span>
                <span data-lang="es" class="hidden">{ritual.name.es}</span>
              </h3>
              <p class="mt-4 text-sm leading-6 text-warm-600 text-center">
                <span data-lang="en">{ritual.description.en}</span>
                <span data-lang="es" class="hidden">{ritual.description.es}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section-padding bg-gradient-to-br from-gold-500 via-gold-600 to-gold-700 text-white">
      <div class="container-narrow mx-auto text-center">
        <h2 class="text-white text-3xl md:text-4xl font-serif">
          <span data-lang="en">Ready to Plan Your Perfect Ceremony?</span>
          <span data-lang="es" class="hidden">¿Listos para planificar la ceremonia perfecta?</span>
        </h2>
        <p class="mt-4 text-gold-100 text-lg max-w-2xl mx-auto">
          <span data-lang="en">Let's create a ceremony that truly reflects your love story. I can't wait to hear from you!</span>
          <span data-lang="es" class="hidden">Creemos una ceremonia que realmente refleje tu historia de amor. ¡Estoy deseando saber de ti!</span>
        </p>
        <div class="mt-8">
          <Button href="/contact" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-gold-600">
            <span data-lang="en">{common.getInTouch.en}</span>
            <span data-lang="es" class="hidden">{common.getInTouch.es}</span>
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>

<script>
  function initLanguage() {
    const lang = localStorage.getItem('lang') || 'en';
    document.querySelectorAll('[data-lang]').forEach((el) => {
      const elLang = el.getAttribute('data-lang');
      if (elLang === lang) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }
  initLanguage();
  document.addEventListener('astro:page-load', initLanguage);
</script>
