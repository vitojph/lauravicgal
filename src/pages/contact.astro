---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SocialLinks from '../components/common/SocialLinks.astro';
import { translations } from '../i18n/translations';

const t = translations.contact;
---

<Layout
  title="Contact | Laura Vicente"
  description="Get in touch with Laura Vicente for custom artwork commissions, wedding ceremony services, or art workshop inquiries."
>
  <Header lang="en" />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative py-20 md:py-32 watercolor-bg overflow-hidden">
      <div class="absolute inset-0">
        <div class="absolute top-10 -left-20 w-64 h-64 bg-gold-200/40 rounded-full blur-3xl"></div>
        <div class="absolute bottom-10 -right-20 w-80 h-80 bg-terracotta-200/30 rounded-full blur-3xl"></div>
      </div>

      <div class="container-narrow mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <h1 class="text-warm-900">
          <span data-lang="en">{t.pageTitle.en}</span>
          <span data-lang="es" class="hidden">{t.pageTitle.es}</span>
        </h1>
        <p class="mt-4 text-xl text-warm-600 max-w-2xl mx-auto">
          <span data-lang="en">{t.pageSubtitle.en}</span>
          <span data-lang="es" class="hidden">{t.pageSubtitle.es}</span>
        </p>
      </div>
    </section>

    <!-- Contact Info Section -->
    <section class="section-padding bg-white">
      <div class="container-narrow mx-auto">
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Contact Details -->
          <div>
            <h2 class="text-2xl font-serif font-semibold text-warm-900 mb-8">
              <span data-lang="en">Contact Information</span>
              <span data-lang="es" class="hidden">Informacion de Contacto</span>
            </h2>

            <div class="space-y-6">
              <!-- Instagram -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-terracotta-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-terracotta-500" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-medium text-warm-900">
                    <span data-lang="en">{t.emailLabel.en}</span>
                    <span data-lang="es" class="hidden">{t.emailLabel.es}</span>
                  </h3>
                  <a
                    href="https://instagram.com/lauravicgaldreams"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-terracotta-600 hover:text-terracotta-700 transition-colors"
                  >
                    @lauravicgaldreams
                  </a>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-gold-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-medium text-warm-900">
                    <span data-lang="en">{t.phoneLabel.en}</span>
                    <span data-lang="es" class="hidden">{t.phoneLabel.es}</span>
                  </h3>
                  <a
                    href="tel:+12016772927"
                    class="text-gold-600 hover:text-gold-700 transition-colors"
                  >
                    +1 (201) 677-2927
                  </a>
                </div>
              </div>

              <!-- Location -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-sage-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-sage-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-medium text-warm-900">
                    <span data-lang="en">{t.locationLabel.en}</span>
                    <span data-lang="es" class="hidden">{t.locationLabel.es}</span>
                  </h3>
                  <p class="text-warm-600">
                    <span data-lang="en">{t.location.en}</span>
                    <span data-lang="es" class="hidden">{t.location.es}</span>
                  </p>
                </div>
              </div>
            </div>

            <!-- Social Links -->
            <div class="mt-10">
              <h3 class="font-medium text-warm-900 mb-4">
                <span data-lang="en">{t.followMe.en}</span>
                <span data-lang="es" class="hidden">{t.followMe.es}</span>
              </h3>
              <SocialLinks size="lg" />
            </div>
          </div>

          <!-- What to expect / Quick links -->
          <div>
            <h2 class="text-2xl font-serif font-semibold text-warm-900 mb-8">
              <span data-lang="en">How Can I Help?</span>
              <span data-lang="es" class="hidden">Como Puedo Ayudarte?</span>
            </h2>

            <div class="space-y-4">
              <a
                href="/commissions"
                class="block p-6 rounded-xl border-2 border-warm-200 hover:border-terracotta-300 hover:bg-terracotta-50 transition-all group"
              >
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-lg bg-terracotta-100 flex items-center justify-center group-hover:bg-terracotta-200 transition-colors">
                    <svg class="w-5 h-5 text-terracotta-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-medium text-warm-900">
                      <span data-lang="en">Commission Artwork</span>
                      <span data-lang="es" class="hidden">Encargar Arte</span>
                    </h3>
                    <p class="text-sm text-warm-600">
                      <span data-lang="en">Custom watercolor paintings</span>
                      <span data-lang="es" class="hidden">Pinturas personalizadas en acuarela</span>
                    </p>
                  </div>
                </div>
              </a>

              <a
                href="/events"
                class="block p-6 rounded-xl border-2 border-warm-200 hover:border-gold-300 hover:bg-gold-50 transition-all group"
              >
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-lg bg-gold-100 flex items-center justify-center group-hover:bg-gold-200 transition-colors">
                    <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-medium text-warm-900">
                      <span data-lang="en">Wedding Ceremonies</span>
                      <span data-lang="es" class="hidden">Ceremonias de Boda</span>
                    </h3>
                    <p class="text-sm text-warm-600">
                      <span data-lang="en">Bilingual ceremony services</span>
                      <span data-lang="es" class="hidden">Servicios de ceremonia bilingue</span>
                    </p>
                  </div>
                </div>
              </a>

              <a
                href="/workshops"
                class="block p-6 rounded-xl border-2 border-warm-200 hover:border-sage-300 hover:bg-sage-50 transition-all group"
              >
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-lg bg-sage-100 flex items-center justify-center group-hover:bg-sage-200 transition-colors">
                    <svg class="w-5 h-5 text-sage-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-medium text-warm-900">
                      <span data-lang="en">Art Workshops</span>
                      <span data-lang="es" class="hidden">Talleres de Arte</span>
                    </h3>
                    <p class="text-sm text-warm-600">
                      <span data-lang="en">Team building & private events</span>
                      <span data-lang="es" class="hidden">Team building y eventos privados</span>
                    </p>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Response time note -->
    <section class="py-12 bg-warm-50">
      <div class="container-narrow mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-warm-600">
          <span data-lang="en">I typically respond within 24-48 hours. Looking forward to hearing from you!</span>
          <span data-lang="es" class="hidden">Normalmente respondo en 24-48 horas. Espero saber de ti!</span>
        </p>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>

<script>
  function initLanguage() {
    const lang = localStorage.getItem('lang') || 'en';
    document.querySelectorAll('[data-lang]').forEach((el) => {
      const elLang = el.getAttribute('data-lang');
      if (elLang === lang) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }
  initLanguage();
  document.addEventListener('astro:page-load', initLanguage);
</script>
