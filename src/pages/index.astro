---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Hero from '../components/home/Hero.astro';
import ServicesPreview from '../components/home/ServicesPreview.astro';
import Button from '../components/common/Button.astro';
import Testimonials from '../components/home/Testimonials.astro';
import { translations } from '../i18n/translations';

// For static build, default to English but render both languages
const t = translations;
---

<Layout
  title="Laura Vicente | Watercolor Artist & Wedding Officiant"
  description="Watercolor artist, wedding officiant, and cultural creative based in the NY/NJ area. Custom artwork, ceremony services, and art workshops."
>
  <Header lang="en" />

  <main class="flex-grow">
    <Hero lang="en" />
    <ServicesPreview lang="en" />

    <!-- Featured Work Section -->
    <section class="section-padding bg-warm-50">
      <div class="container-wide mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-warm-900">
            <span data-lang="en">{t.home.featuredWork.en}</span>
            <span data-lang="es" class="hidden">{t.home.featuredWork.es}</span>
          </h2>
          <div class="mt-4 w-24 h-1 bg-gradient-to-r from-terracotta-400 via-gold-400 to-sage-400 mx-auto rounded-full"></div>
        </div>

        <!-- Featured work grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <!-- Position 1 -->
          <div class="aspect-square rounded-xl overflow-hidden group hover:shadow-lg transition-shadow cursor-pointer">
            <img src="/images/bkln-bridge.jpg" alt="Brooklyn Bridge watercolor" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <!-- Position 2 -->
          <div class="aspect-square rounded-xl overflow-hidden group hover:shadow-lg transition-shadow cursor-pointer">
            <img src="/images/workshop-table.jpg" alt="Workshop table" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <!-- Position 3 -->
          <div class="aspect-square rounded-xl overflow-hidden group hover:shadow-lg transition-shadow cursor-pointer">
            <img src="/images/laura-paintaing.jpg" alt="Laura painting" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <!-- Position 4 -->
          <div class="aspect-square rounded-xl overflow-hidden group hover:shadow-lg transition-shadow cursor-pointer">
            <img src="/images/laura-arnic-workshop.png" alt="Laura Arnic workshop" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
        </div>

        <div class="text-center mt-10">
          <Button href="/gallery" variant="outline">
            <span data-lang="en">{t.common.viewGallery.en}</span>
            <span data-lang="es" class="hidden">{t.common.viewGallery.es}</span>
          </Button>
        </div>
      </div>
    </section>

    <Testimonials />

    <!-- CTA Section -->
    <section class="section-padding bg-gradient-to-br from-terracotta-500 via-terracotta-600 to-terracotta-700 text-white">
      <div class="container-narrow mx-auto text-center">
        <h2 class="text-white text-3xl md:text-4xl font-serif">
          <span data-lang="en">Let's Create Something Beautiful Together</span>
          <span data-lang="es" class="hidden">Creemos Algo Hermoso Juntos</span>
        </h2>
        <p class="mt-4 text-terracotta-100 text-lg max-w-2xl mx-auto">
          <span data-lang="en">Whether you're looking for custom artwork, a meaningful ceremony, or a creative workshop experience, I'd love to hear from you.</span>
          <span data-lang="es" class="hidden">Ya sea que busques arte personalizado, una ceremonia significativa o una experiencia creativa en un taller, me encantaría saber de ti.</span>
        </p>
        <div class="mt-8">
          <Button href="/contact" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-terracotta-600">
            <span data-lang="en">{t.common.getInTouch.en}</span>
            <span data-lang="es" class="hidden">{t.common.getInTouch.es}</span>
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>

<script>
  function initLanguage() {
    const lang = localStorage.getItem('lang') || 'en';
    document.querySelectorAll('[data-lang]').forEach((el) => {
      const elLang = el.getAttribute('data-lang');
      if (elLang === lang) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }

  initLanguage();
  document.addEventListener('astro:page-load', initLanguage);
  window.addEventListener('languagechange', initLanguage);
</script>
