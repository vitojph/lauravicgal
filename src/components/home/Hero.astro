---
import Button from '../common/Button.astro';
import { translations, type Language } from '../../i18n/translations';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const t = translations.home;
---

<section class="relative min-h-[90vh] flex items-center watercolor-bg overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-20 -left-20 w-64 h-64 bg-terracotta-200/30 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 -right-20 w-80 h-80 bg-sage-200/30 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gold-200/20 rounded-full blur-3xl"></div>
  </div>

  <div class="container-wide mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif font-semibold text-warm-900 leading-tight">
          {t.heroTitle[lang]}
        </h1>
        <p class="mt-6 text-xl md:text-2xl text-warm-600 max-w-2xl mx-auto lg:mx-0">
          {t.heroSubtitle[lang]}
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <Button href="/gallery" variant="primary" size="lg">
            {translations.common.viewGallery[lang]}
          </Button>
          <Button href="/contact" variant="outline" size="lg">
            {translations.common.getInTouch[lang]}
          </Button>
        </div>
      </div>

      <!-- Hero Image Placeholder -->
      <div class="relative">
        <div class="aspect-[4/5] rounded-2xl shadow-2xl overflow-hidden">
          <img src="/images/color-samples.jpg" alt="Watercolor artwork by Laura Vicente" class="w-full h-full object-cover" />
        </div>
        <!-- Decorative frame -->
        <div class="absolute -inset-4 border-2 border-terracotta-200 rounded-2xl -z-10"></div>
      </div>
    </div>
  </div>
</section>
