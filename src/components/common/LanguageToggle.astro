---
// Language Toggle Component
// Uses localStorage to persist language preference
---

<div class="language-toggle relative">
  <button
    id="lang-toggle"
    class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-warm-300 hover:border-terracotta-400 hover:bg-terracotta-50 transition-all text-sm font-medium"
    aria-label="Toggle language"
  >
    <span id="current-lang" class="uppercase">EN</span>
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
      />
    </svg>
  </button>
</div>

<script>
  function initLanguageToggle() {
    const toggle = document.getElementById('lang-toggle');
    const currentLangEl = document.getElementById('current-lang');

    if (!toggle || !currentLangEl) return;

    // Get current language
    const getCurrentLang = () => localStorage.getItem('lang') || 'en';

    // Update display
    const updateDisplay = () => {
      const lang = getCurrentLang();
      currentLangEl.textContent = lang.toUpperCase();
      document.documentElement.setAttribute('data-lang', lang);
      document.documentElement.lang = lang;
    };

    // Toggle language
    toggle.addEventListener('click', () => {
      const currentLang = getCurrentLang();
      const newLang = currentLang === 'en' ? 'es' : 'en';
      localStorage.setItem('lang', newLang);
      updateDisplay();

      // Dispatch custom event for other components to listen to
      window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang: newLang } }));

      // Reload page to apply translations
      window.location.reload();
    });

    // Initialize display
    updateDisplay();
  }

  // Run on initial load
  initLanguageToggle();

  // Re-run on Astro page navigation
  document.addEventListener('astro:page-load', initLanguageToggle);
</script>
